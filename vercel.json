{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/landing(/.*)?",
      "dest": "/index.html",
      "continue": true
    },
    {
      "src": "/index.css",
      "dest": "/index.css"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
